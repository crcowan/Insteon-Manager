# Insteon Bridge Configuration

# openHAB REST Configuration
OPENHAB_URL=http://localhost:8080
# Generate an API token in openHAB under Profile -> API Tokens
OPENHAB_TOKEN=oh.insteonbridge.your_token_here
# Thing UID of the Insteon Bridge/Network in openHAB (e.g. insteon:network:local)
OPENHAB_THING_UID=insteon:network:local

# Insteon Serial Port Configuration
# It is strongly recommended to use /dev/serial/by-id/... on Raspberry Pi to avoid port shifts
INSTEON_PORT=/dev/ttyUSB0
INSTEON_BAUD=19200

# Session Lock Watchdog (seconds)
# If the frontend crashes or loses connection, the backend will automatically
# disconnect pyinsteon and re-enable openHAB after this period.
SESSION_TIMEOUT_SECONDS=300

# Local pyinsteon device/ALDB cache path
CACHE_DIR=/var/lib/insteon-bridge/cache

# Server host & port
HOST=0.0.0.0
PORT=8000
