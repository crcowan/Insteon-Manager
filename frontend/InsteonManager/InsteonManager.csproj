<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>InsteonManager</AssemblyName>
    <AssemblyTitle>Insteon Network Studio</AssemblyTitle>
    <Product>Insteon Network Studio</Product>
    <Description>Insteon Smart Home Network Topology, Diagnostics and ALDB Management Suite</Description>
    <Version>2.0.0</Version>
    <FileVersion>2.0.0.0</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="icon.ico" />
    <Resource Include="icon.png" />
  </ItemGroup>

</Project>
